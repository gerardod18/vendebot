{
  "name": "vendebot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-tenant Instagram DM automation + AI sales agent (React + Convex)",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@convex-dev/agent": "^0.7.9",
    "@convex-dev/better-auth": "^0.12.7",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/workflow": "^0.4.10",
    "@convex-dev/workpool": "^0.4.15",
    "ai": "^7.0.162",
    "better-auth": "^1.6.34",
    "convex": "^1.49.0",
    "convex-helpers": "^0.1.133",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "convex-test": "^0.0.67",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
