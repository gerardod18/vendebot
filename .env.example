# Frontend (.env.local). `npx convex dev` writes VITE_CONVEX_URL automatically.
VITE_CONVEX_URL=https://<deployment>.convex.cloud
VITE_CONVEX_SITE_URL=https://<deployment>.convex.site

# Backend vars are set in the Convex dashboard (or `npx convex env set NAME value`):
# SITE_URL, BETTER_AUTH_SECRET, META_APP_ID, META_APP_SECRET, META_WEBHOOK_VERIFY_TOKEN,
# META_GRAPH_VERSION, TOKEN_ENCRYPTION_KEY, ANTHROPIC_API_KEY,
# OPENROUTER_API_KEY (optional, enables the OpenRouter provider), BILLING_WEBHOOK_SECRET (optional)
# META_CONFIG_ID: Instagram unified-login configuration id (Meta dashboard → Instagram → API setup with Unified login).
# WhatsApp numbers are connected in the app (Accounts page) with their phone number id, WABA id and token.
# META_PUBLIC_URL: public https URL of the Convex HTTP actions (tunnel URL in dev); used for the OAuth redirect URI. Defaults to CONVEX_SITE_URL.
# SUPERADMIN_EMAILS: comma separated emails allowed to claim the platform superAdmin role (see docs/DECISIONS.md D12).
