# Frontend (.env.local). `npx convex dev` writes VITE_CONVEX_URL automatically.
VITE_CONVEX_URL=https://<deployment>.convex.cloud
VITE_CONVEX_SITE_URL=https://<deployment>.convex.site

# Backend vars are set in the Convex dashboard (or `npx convex env set NAME value`):
# SITE_URL, BETTER_AUTH_SECRET, META_APP_ID, META_APP_SECRET, META_WEBHOOK_VERIFY_TOKEN,
# META_GRAPH_VERSION, TOKEN_ENCRYPTION_KEY, ANTHROPIC_API_KEY
